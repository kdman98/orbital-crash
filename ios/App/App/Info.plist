<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Orbital Crash</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- Capacitor's template ships `armv7` here, which is a leftover from the 32-bit era: armv7 devices
	     topped out at iOS 10 and this target is 13.0, so the declared requirement can never be satisfied
	     by a device that can also run the app. arm64 is what the binary is actually built for. -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- LANDSCAPE ONLY, ON BOTH FAMILIES, BOTH WAYS ROUND.
	     An earlier revision locked this to portrait and justified it as fairness — the claim was that
	     landscape hands the player a wider field at the same spawn rate. THAT CLAIM WAS FALSE, and the
	     arithmetic is worth keeping so nobody reinstates it. The scale is `S = min(1, min(vw,vh)/800)`,
	     which keys on the SHORT side, so on iPhone 17 Pro:
	         portrait   402x874 -> S=0.502 -> world  800 x 1739, area 1.391M, spawnR = max(W,H)*0.6 = 1044
	         landscape  874x402 -> S=0.502 -> world 1739 x  800, area 1.391M, spawnR                = 1044
	     Rotating is exactly area-neutral AND spawn-radius-neutral; width is traded for height one for
	     one. Landscape is in fact the more faithful shape: aspect 2.17 against the 1.78 of the desktop
	     window every constant in this game was tuned in, where portrait's 0.46 was 3.9x off.
	     Both landscape variants are allowed so the notch can sit on either hand. UIRequiresFullScreen
	     stays because iPad refuses a partial orientation set without it. The web manifest must agree —
	     on native this plist is the enforcement; there `orientation` is only advisory, and only in a PWA. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>
	<!-- No status bar. The HUD already reserves the notch area through env(safe-area-inset-top), so the
	     clock would sit ON the score readout rather than above it. Switching the VC-based key off is
	     what lets this static one win — leave it true and Capacitor's bridge controller decides instead. -->
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<!-- PROMOTION. iOS clamps ALL animation — including a WKWebView's requestAnimationFrame — to 60Hz
	     unless this key says otherwise, so on a 120Hz phone the game would render at 60 no matter how
	     much headroom it had. With it true, rAF is free to run at the panel's real rate.
	       ⚠️ IT CANNOT BE VERIFIED IN THE SIMULATOR. The simulator takes its refresh rate from the host
	     Mac's display, and the Mac this was added on is a 60Hz MacBook Air — so every "60fps" measured
	     there was the LAPTOP's ceiling, not the game's. This key only shows an effect on real ProMotion
	     hardware, and that is the only place it can be signed off.
	       What made it safe to add: the simulation is fixed-step (`acc += dt; while(acc>=1/60) step()`),
	     so a faster render rate draws the same game more often rather than running it faster. The two
	     places that counted RENDERED frames instead of seconds — the sky cache cadence and the death
	     shatter drift — were converted to wall-clock at the same time as this. Anything added later that
	     ticks per frame rather than per dt will be twice as fast here and correct at 60. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
</dict>
</plist>
